# Copy this file to .env and fill in the values:
#   PowerShell:  Copy-Item .env.example .env
#   Mac/Linux:   cp .env.example .env

# ---- Required ----
DB_ROOT_PASSWORD=change-me
DB_USER=urlapp
DB_PASSWORD=change-me
# Must be at least 32 characters. Generate one with:
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   Mac/Linux:   openssl rand -base64 48
JWT_SECRET=generate-a-long-random-string-at-least-40-chars

# ---- Optional ----
# Public base URL used to build short links
BASE_URL=http://localhost:8080

# AI categorization (off by default). Set to true and add a Groq API key to enable.
AI_TAGGING_ENABLED=false
GROQ_API_KEY=

# Set to "native" only when the app runs behind a trusted proxy (nginx, load balancer).
FORWARD_HEADERS_STRATEGY=none